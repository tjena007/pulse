# ---- Server ----
PORT=4321
# 127.0.0.1 = this machine only. Use 0.0.0.0 to reach it from other devices on your LAN/Tailscale.
HOST=127.0.0.1
REFRESH_MINUTES=30

# ---- LLM (optional; the feed still works without one) ----
# none | ollama | anthropic | openai
LLM_PROVIDER=ollama

# Ollama (fully local, free)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# OpenAI or any OpenAI-compatible server (LM Studio, vLLM, OpenRouter...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# How many top candidates get AI summaries per refresh
LLM_ENRICH_LIMIT=40

# ---- GitHub (optional; raises Search API rate limit from 10 to 30 req/min) ----
GITHUB_TOKEN=
