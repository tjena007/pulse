{
  "name": "pulse",
  "version": "0.1.0",
  "private": true,
  "description": "Localhost personalized AI news feed + trending GitHub repos",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/server.ts",
    "dev": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch src/server.ts",
    "demo": "MOCK=1 NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/server.ts",
    "refresh": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/cli-refresh.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^8.1.0",
    "cheerio": "^1.0.0",
    "fast-xml-parser": "^5.2.0",
    "fastify": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
